{
  "name": "@f12o/yami-kumo",
  "version": "0.1.0-preview.1",
  "description": "MoonBit-powered, React-independent Kumo HTML components and an optional React AppShell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f4ah6o/Yami-kumo.git",
    "directory": "npm"
  },
  "files": [
    "*.js",
    "*.d.ts",
    "styles.css",
    "README.md",
    "ACKNOWLEDGEMENTS.md",
    "LICENSE",
    "licenses/",
    "BUILD.json"
  ],
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./dom": {
      "types": "./dom.d.ts",
      "import": "./dom.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
