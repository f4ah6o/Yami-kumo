    "error|sm" => "border-0 bg-kumo-control text-kumo-default ring ring-kumo-line outline-none focus:outline-none kumo-input-placeholder disabled:text-kumo-disabled h-6.5 gap-1 rounded-md px-2 text-xs !ring-kumo-danger focus:ring-[1.5px] focus:ring-kumo-danger/50"
    "default|base" => "border-0 bg-kumo-control text-kumo-default ring ring-kumo-line outline-none focus:outline-none kumo-input-placeholder disabled:text-kumo-disabled h-9 gap-1.5 rounded-lg px-3 text-base focus:ring-[1.5px] focus:ring-kumo-focus/50"
