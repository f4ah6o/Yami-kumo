}

///|
fn generated_text_classes(key : String) -> String {
  match key {
    "heading|xs" => "text-kumo-default text-lg font-semibold"
    "body|xs" => "text-kumo-default text-xs/[inherit]"
    "secondary|xs" => "text-kumo-subtle text-xs/[inherit]"
    "success|xs" => "text-kumo-link text-xs/[inherit]"
    "error|xs" => "text-kumo-danger text-xs/[inherit]"
    "mono|xs" => "text-kumo-default font-mono text-sm/[inherit]"
    "mono-secondary|xs" => "font-mono text-kumo-subtle text-sm/[inherit]"
    "heading|sm" => "text-kumo-default text-lg font-semibold"
    "body|sm" => "text-kumo-default text-sm/[inherit]"
    "secondary|sm" => "text-kumo-subtle text-sm/[inherit]"
    "success|sm" => "text-kumo-link text-sm/[inherit]"
    "error|sm" => "text-kumo-danger text-sm/[inherit]"
    "mono|sm" => "text-kumo-default font-mono text-sm/[inherit]"
    "mono-secondary|sm" => "font-mono text-kumo-subtle text-sm/[inherit]"
    "heading|base" => "text-kumo-default text-lg font-semibold"
    "body|base" => "text-kumo-default text-base/[inherit]"
    "secondary|base" => "text-kumo-subtle text-base/[inherit]"
    "success|base" => "text-kumo-link text-base/[inherit]"
    "error|base" => "text-kumo-danger text-base/[inherit]"
    "mono|base" => "text-kumo-default font-mono text-sm/[inherit]"
    "mono-secondary|base" => "font-mono text-kumo-subtle text-sm/[inherit]"
    "heading|lg" => "text-kumo-default font-semibold text-xl"
    "body|lg" => "text-kumo-default text-lg/[inherit]"
    "secondary|lg" => "text-kumo-subtle text-lg/[inherit]"
    "success|lg" => "text-kumo-link text-lg/[inherit]"
    "error|lg" => "text-kumo-danger text-lg/[inherit]"
    "mono|lg" => "text-kumo-default font-mono text-base/[inherit]"
    "mono-secondary|lg" => "font-mono text-kumo-subtle text-base/[inherit]"
    _ => ""
  }
}

///|
fn generated_layer_card_class(key : String) -> String {
  match key {
    "simple" => "overflow-hidden rounded-lg bg-kumo-base shadow-xs ring ring-kumo-line"
    "layered" => "flex w-full flex-col overflow-hidden rounded-lg bg-kumo-elevated text-base ring ring-kumo-hairline"
    "primary" => "relative flex flex-col gap-2 overflow-hidden rounded-lg bg-kumo-base p-4 pr-3 text-inherit no-underline ring ring-kumo-fill"
    "secondary" => "-my-2 flex items-center gap-2 bg-kumo-elevated p-4 text-base font-medium text-kumo-subtle"
    _ => ""
  }
}
