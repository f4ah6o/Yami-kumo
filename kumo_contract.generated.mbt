    "default|lg" => "border-0 bg-kumo-control text-kumo-default ring ring-kumo-line outline-none focus:outline-none kumo-input-placeholder disabled:text-kumo-disabled h-10 gap-2 rounded-lg px-4 text-base focus:ring-[1.5px] focus:ring-kumo-focus/50"
