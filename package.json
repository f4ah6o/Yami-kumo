{
  "name": "yami-kumo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:kumo-contract": "node scripts/generate-kumo-contract.mjs",
    "check:kumo-contract": "node scripts/generate-kumo-contract.mjs --check",
    "moon:check": "moon check --target all",
    "moon:build": "moon build browser --target js --release",
    "moon:test": "moon test --target all",
    "check:moon-build": "node scripts/check-moonbit-build.mjs",
    "dev:parity": "pnpm run moon:build && vp dev --host 127.0.0.1",
    "build:parity": "pnpm run check:kumo-contract && pnpm run moon:check && pnpm run moon:test && pnpm run moon:build && pnpm run check:moon-build && vp build",
    "test": "pnpm run check:kumo-contract && pnpm run moon:check && pnpm run moon:test && pnpm run check:moon-build",
    "build:npm": "node scripts/build-npm.mjs",
    "pack:npm": "pnpm run build:npm && npm pack ./dist/npm --pack-destination ./dist",
    "test:npm": "node scripts/test-npm-consumers.mjs",
    "build:shared-ui": "moon build examples/shared_counter_dom --target js --release --deny-warn",
    "generate:shared-theme": "node scripts/generate-shared-theme.mjs",
    "check:shared-theme": "node scripts/generate-shared-theme.mjs --check",
    "test:shared-ui": "pnpm run check:shared-theme && pnpm run build:shared-ui && node --test tests/shared-ui/*.test.mjs && node scripts/check-shared-ui-consumers.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.6",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.24.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ]
    }
  }
}
