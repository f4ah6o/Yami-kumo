# Publish only the MoonBit library, its browser adapter, styles, docs, and licenses.
*
!/.moonignore
!/moon.mod
!/moon.pkg
!/pkg.generated.mbti
!/README.mbt.md
!/LICENSE
!/ACKNOWLEDGEMENTS.md
# Keep the nested native module packageable as its own Mooncakes module.
!/native/
!/*.mbt
!/dom/
!/ui/
!/examples/
!/ui/**
!/examples/shared_button_theme/**
!/examples/shared_button_theme/
!/examples/shared_counter/**
!/examples/shared_counter/
!/examples/shared_settings/**
!/examples/shared_settings/
!/dom/moon.pkg
!/dom/*.mbt
!/styles/
!/styles/kumo-standalone.css
!/styles/yami-kumo-components.css
!/licenses/
!/licenses/cloudflare-kumo-LICENSE
